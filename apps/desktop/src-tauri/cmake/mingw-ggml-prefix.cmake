if (WIN32 AND MINGW)
    if (DEFINED ENV{ORATYPE_WIN_VULKAN_SDK} AND NOT "$ENV{ORATYPE_WIN_VULKAN_SDK}" STREQUAL "")
        file(TO_CMAKE_PATH "$ENV{ORATYPE_WIN_VULKAN_SDK}" _oratype_vk_sdk)
        set(Vulkan_INCLUDE_DIR "${_oratype_vk_sdk}/include")
        set(Vulkan_LIBRARY "${_oratype_vk_sdk}/lib/libvulkan.dll.a")
    endif()
    if (DEFINED ENV{ORATYPE_WIN_GLSLC} AND NOT "$ENV{ORATYPE_WIN_GLSLC}" STREQUAL "")
        file(TO_CMAKE_PATH "$ENV{ORATYPE_WIN_GLSLC}" _oratype_glslc)
        set(Vulkan_GLSLC_EXECUTABLE "${_oratype_glslc}")
    endif()

    function(_oratype_fix_mingw_ggml_prefixes)
        foreach(_tgt IN ITEMS ggml ggml-base ggml-cpu ggml-vulkan)
            if (TARGET ${_tgt})
                set_target_properties(${_tgt} PROPERTIES PREFIX "lib")
            endif()
        endforeach()
    endfunction()
    cmake_language(DEFER CALL _oratype_fix_mingw_ggml_prefixes)
endif()
